# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/yato?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
JWT_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32"
ENCRYPTION_KEY="CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32" # Minimum 32 characters

# CORS (comma-separated origins, e.g. "https://yato.example.com,http://localhost:3000")
CORS_ORIGINS="http://localhost:3000"

# External APIs
WAHA_URL="http://localhost:3001"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="user"
SMTP_PASS="pass"
